{
  "name": "solid-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/setup-db.mjs && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "db:setup": "node scripts/setup-db.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "db:migrate-uuids": "node scripts/setup-db.mjs --migrate-uuids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.6.0",
    "lucide-preact": "^0.575.0",
    "preact": "^10.25.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@preact/preset-vite": "^2.9.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
